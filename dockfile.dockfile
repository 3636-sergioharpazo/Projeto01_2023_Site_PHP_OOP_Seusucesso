# Usar imagem oficial do Node.js
FROM node:16

# Criar e definir o diretório de trabalho
WORKDIR /usr/src/app

# Copiar o package.json e instalar as dependências
COPY package*.json ./
RUN npm install

# Copiar o código restante
COPY . .

# Expor a porta que o app vai rodar
EXPOSE 3000

# Comando para rodar o app
CMD [ "npm", "start" ]
